<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="outreach_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!--
            Postgres. Two behaviours the application depends on are specific
            to it: an unaliased COUNT(*) in a grouped query throws, and LIKE
            compares case, so a lead search for "acme" does not find "Acme".

            Only the connection and the database name are forced. The host, port
            and credentials are left to the environment, so this works from a
            terminal, where .env points at localhost, and inside a container,
            where Compose points at the postgres service.

            Requires the database to exist:
            docker compose exec postgres psql -U postgres -c "CREATE DATABASE outreach_test;"

            Docker sets DB_* and QUEUE_CONNECTION as container environment
            variables. Laravel reads $_SERVER first, which <env> does not write
            to, so the name must be declared here as well - otherwise the suite
            connects to the live database and RefreshDatabase drops every table
            in it. TestDatabaseIsolationTest is the belt to this brace.
        -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="outreach_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <!-- The two guarded API actions are pinned off so the suite does not
             depend on whatever a developer left in their own .env. -->
        <server name="OUTREACH_API_ALLOW_APPROVAL" value="false" force="true"/>
        <server name="OUTREACH_API_ALLOW_SUPPRESSION_REMOVAL" value="false" force="true"/>
    </php>
</phpunit>
