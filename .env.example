APP_NAME="Outreach Agent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose. Running without Docker, point these at your own Postgres.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=outreach
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Outreach mail goes out through the Gmail API, not this mailer. This is only
# for anything the application itself sends, such as password resets.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Drafting ---
# 'api' calls Claude and needs a key. 'mock' drafts offline for local testing:
# no key, no cost, same output every run, every subject prefixed [MOCK DRAFT].
ANTHROPIC_DRAFTER=api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=1500
ANTHROPIC_TIMEOUT=120

# --- Google / Gmail ---
# See docs/google-cloud-setup.md. The redirect URI must match the one registered
# in the Google Cloud console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

# --- Sending behaviour ---
# Timezone drives the dashboard and the default per-mailbox sending window.
OUTREACH_TIMEZONE=UTC
OUTREACH_DAILY_CAP_DEFAULT=40
OUTREACH_MIN_GAP_MINUTES=3
OUTREACH_MAX_GAP_MINUTES=15
OUTREACH_SEND_WINDOW_START=09:00
OUTREACH_SEND_WINDOW_END=17:00
OUTREACH_SEND_WEEKENDS=false

# New mailboxes ramp up rather than sending at full rate immediately.
OUTREACH_WARMUP_START=5
OUTREACH_WARMUP_INCREMENT=3

# A mailbox is paused automatically above this bounce rate, once it has sent
# at least the minimum number of emails.
OUTREACH_BOUNCE_PAUSE_THRESHOLD=0.05
OUTREACH_BOUNCE_MIN_SENDS=20

# Starting point for the DKIM lookup; other common selectors are tried too.
OUTREACH_DKIM_SELECTOR=google
OUTREACH_LIST_UNSUBSCRIBE=true
